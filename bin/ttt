#!/usr/bin/env python3
"""ttt — command line client for tabtabtab (gv-code) cloud dev environments.

Zero-dependency (Python 3.9+ standard library only). Talks to:
  * the tabtabtab control plane (default https://api.tabtabtab.ai) for
    auth, VMs ("envs"), repositories, and env vars
  * each VM's gv-code server (https://<env-domain>) for incoming
    webhooks, agent kickoff, and file uploads

Environment variables:
  TTT_API_URL / GV_API_URL      override the control plane URL
  TTT_API_TOKEN / GV_API_TOKEN  bearer token (skips browser login)
"""

from __future__ import annotations

import argparse
import base64
import getpass
import hashlib
import json
import mimetypes
import os
import secrets
import socketserver
import ssl
import stat
import subprocess
import sys
import tempfile
import time
from http.server import BaseHTTPRequestHandler
from pathlib import Path
from threading import Event, Thread
from urllib import error, parse, request
from urllib.parse import urlparse

VERSION = "0.1.0"
DEFAULT_API_URL = "https://api.tabtabtab.ai"
OAUTH_SCOPES = "profile email offline_access"
USER_AGENT = f"ttt-cli/{VERSION}"
CONFIG_DIR = Path(os.environ.get("TTT_CONFIG_DIR", "~/.config/ttt")).expanduser()
CONFIG_PATH = CONFIG_DIR / "config.json"
KEYS_DIR = CONFIG_DIR / "keys"
TOKEN_REFRESH_BUFFER_SECONDS = 60

# Attachment limits enforced by the gv-code incoming webhook endpoint.
WEBHOOK_ALLOWED_TYPES = {
    "image/png",
    "image/jpeg",
    "image/webp",
    "image/gif",
    "text/plain",
    "text/markdown",
    "application/json",
    "application/zip",
    "text/csv",
}
WEBHOOK_MAX_ATTACHMENTS = 5
WEBHOOK_MAX_TOTAL_BYTES = 50 * 1024 * 1024
ATTACHMENT_EXTENSION_TYPES = {
    ".md": "text/markdown",
    ".markdown": "text/markdown",
    ".txt": "text/plain",
    ".log": "text/plain",
    ".json": "application/json",
    ".csv": "text/csv",
    ".zip": "application/zip",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".webp": "image/webp",
    ".gif": "image/gif",
}


class CliError(RuntimeError):
    """Error with a message meant directly for the user."""


class ApiError(CliError):
    def __init__(self, message: str, status_code: int):
        super().__init__(message)
        self.status_code = status_code


# ---------------------------------------------------------------------------
# Config


def load_config() -> dict:
    try:
        return json.loads(CONFIG_PATH.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_config(config: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(config, indent=2) + "\n")
    CONFIG_PATH.chmod(0o600)


def api_url() -> str:
    for var in ("TTT_API_URL", "GV_API_URL"):
        value = os.environ.get(var)
        if value:
            return value.rstrip("/")
    value = load_config().get("api_url")
    if value:
        return str(value).rstrip("/")
    return DEFAULT_API_URL


# ---------------------------------------------------------------------------
# HTTP helpers


def _read_error_message(raw: str, status_code: int) -> str:
    try:
        payload = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        payload = {}
    if isinstance(payload, dict):
        for key in ("detail", "message", "error_description", "error"):
            value = payload.get(key)
            if isinstance(value, str) and value:
                return value
            if isinstance(value, list):
                messages = [str(item.get("msg")) for item in value if isinstance(item, dict) and item.get("msg")]
                if messages:
                    return "; ".join(messages)
    if raw.strip():
        return f"HTTP {status_code}: {raw.strip()[:500]}"
    return f"HTTP {status_code}"


_SSL_CONTEXT: ssl.SSLContext | None = None


def _ssl_context() -> ssl.SSLContext:
    """Default TLS context, with fallbacks for Pythons shipped without a CA bundle."""
    global _SSL_CONTEXT
    if _SSL_CONTEXT is not None:
        return _SSL_CONTEXT
    try:
        import certifi

        _SSL_CONTEXT = ssl.create_default_context(cafile=certifi.where())
        return _SSL_CONTEXT
    except ImportError:
        pass
    context = ssl.create_default_context()
    if context.cert_store_stats().get("x509_ca", 0) == 0:
        for cafile in (
            "/etc/ssl/cert.pem",
            "/etc/ssl/certs/ca-certificates.crt",
            "/etc/pki/tls/certs/ca-bundle.crt",
        ):
            if os.path.exists(cafile):
                context = ssl.create_default_context(cafile=cafile)
                break
    _SSL_CONTEXT = context
    return context


def http_json(
    url: str,
    method: str = "GET",
    payload: dict | None = None,
    headers: dict | None = None,
    form: dict | None = None,
    timeout: int = 60,
) -> dict:
    data = None
    all_headers = {"Accept": "application/json", "User-Agent": USER_AGENT}
    if form is not None:
        data = parse.urlencode(form).encode("utf-8")
        all_headers["Content-Type"] = "application/x-www-form-urlencoded"
    elif payload is not None:
        data = json.dumps(payload).encode("utf-8")
        all_headers["Content-Type"] = "application/json"
    if headers:
        all_headers.update(headers)
    req = request.Request(url, method=method, data=data, headers=all_headers)
    try:
        with request.urlopen(req, timeout=timeout, context=_ssl_context()) as response:
            body = response.read().decode("utf-8")
            return json.loads(body) if body.strip() else {}
    except error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        raise ApiError(_read_error_message(raw, exc.code), exc.code) from exc
    except error.URLError as exc:
        raise CliError(f"Could not reach {urlparse(url).netloc}: {exc.reason}") from exc


# ---------------------------------------------------------------------------
# Auth (Clerk OAuth PKCE — same flow the first-party CLI uses)


def _clerk_frontend_api(publishable_key: str) -> str:
    parts = publishable_key.split("_", 2)
    if len(parts) != 3 or not parts[2]:
        raise CliError("Login is not configured correctly (bad publishable key).")
    encoded = parts[2]
    padding = "=" * ((4 - len(encoded) % 4) % 4)
    decoded = base64.urlsafe_b64decode(encoded + padding).decode("utf-8")
    frontend_api = decoded.rstrip("$").strip()
    if not frontend_api:
        raise CliError("Login is not configured correctly (bad publishable key).")
    return frontend_api


def _open_browser(url: str) -> bool:
    try:
        import webbrowser

        return webbrowser.open(url)
    except Exception:
        return False


def _wait_for_callback(expected_state: str, redirect_uri: str) -> str:
    parsed = urlparse(redirect_uri)
    if parsed.hostname not in {"127.0.0.1", "localhost"} or parsed.port is None:
        raise CliError(f"Unsupported OAuth redirect URI: {redirect_uri}")
    callback_path = parsed.path or "/"
    result: dict = {}
    done = Event()

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:  # noqa: N802 (stdlib API)
            url = urlparse(self.path)
            if url.path != callback_path:
                self.send_response(404)
                self.end_headers()
                return
            query = parse.parse_qs(url.query)
            state = query.get("state", [""])[0]
            code = query.get("code", [""])[0]
            err = query.get("error_description", query.get("error", [""]))[0]
            if state != expected_state:
                result["error"] = "OAuth state mismatch."
            elif err:
                result["error"] = err
            elif not code:
                result["error"] = "Callback did not include an authorization code."
            else:
                result["code"] = code
            message = "Login complete. You can close this window." if "code" in result else "Authentication failed."
            body = f"<html><body><p>{message}</p></body></html>".encode()
            self.send_response(200 if "code" in result else 400)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            done.set()

        def log_message(self, _format: str, *_args: object) -> None:
            return

    class Server(socketserver.TCPServer):
        allow_reuse_address = True

    try:
        server = Server((parsed.hostname, parsed.port), Handler)
    except OSError as exc:
        raise CliError(f"Could not listen on {redirect_uri}: {exc}") from exc

    def read_paste() -> None:
        while not done.is_set():
            try:
                pasted = input().strip()
            except EOFError:
                return
            if not pasted:
                continue
            pasted_url = urlparse(pasted)
            query = parse.parse_qs(pasted_url.query)
            if query.get("state", [""])[0] != expected_state:
                result["error"] = "Pasted URL has the wrong OAuth state."
            elif query.get("code", [""])[0]:
                result["code"] = query["code"][0]
            else:
                result["error"] = "Pasted URL did not include an authorization code."
            done.set()
            return

    try:
        Thread(target=server.handle_request, daemon=True).start()
        Thread(target=read_paste, daemon=True).start()
        done.wait()
    finally:
        server.server_close()

    if result.get("error"):
        raise CliError(str(result["error"]))
    return str(result["code"])


def cmd_login(_args: argparse.Namespace) -> int:
    base = api_url()
    auth = http_json(f"{base}/v1/auth/clerk")
    frontend_api = _clerk_frontend_api(str(auth["publishableKey"]))
    discovery = http_json(f"https://{frontend_api}/.well-known/openid-configuration")
    client_id = str(auth["oauthClientId"])
    redirect_uri = str(auth["oauthRedirectUri"])
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
    state = secrets.token_urlsafe(24)
    auth_url = discovery["authorization_endpoint"] + "?" + parse.urlencode(
        {
            "response_type": "code",
            "client_id": client_id,
            "redirect_uri": redirect_uri,
            "scope": OAUTH_SCOPES,
            "state": state,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
        }
    )

    print("ttt login\n")
    if _open_browser(auth_url):
        print("Opened the login URL in your browser.")
    else:
        print("Open this URL in a browser:")
        print(auth_url)
    print("\nWaiting for the browser callback...")
    print("(If the browser cannot reach this machine, paste the full redirected URL here and press Enter.)")

    code = _wait_for_callback(state, redirect_uri)
    tokens = http_json(
        str(discovery["token_endpoint"]),
        method="POST",
        form={
            "grant_type": "authorization_code",
            "client_id": client_id,
            "code": code,
            "redirect_uri": redirect_uri,
            "code_verifier": verifier,
        },
    )
    config = load_config()
    config["oauth"] = {
        "access_token": tokens["access_token"],
        "refresh_token": tokens.get("refresh_token"),
        "expires_at": time.time() + float(tokens.get("expires_in", 0) or 0),
        "token_endpoint": discovery["token_endpoint"],
        "client_id": client_id,
    }
    save_config(config)
    print(f"\nLogged in. Credentials saved to {CONFIG_PATH}")
    return 0


def cmd_logout(_args: argparse.Namespace) -> int:
    config = load_config()
    if not config.pop("oauth", None):
        print("Already logged out.")
        return 0
    save_config(config)
    print(f"Removed saved login from {CONFIG_PATH}")
    return 0


GV_CONFIG_PATH = Path("~/.config/gv/config.json").expanduser()


def _refresh_if_needed(oauth: dict, persist) -> str:
    """Return a valid access token, refreshing through the saved endpoint if expired."""
    expires_at = oauth.get("expires_at") or 0
    if expires_at and time.time() > float(expires_at) - TOKEN_REFRESH_BUFFER_SECONDS:
        if not (oauth.get("refresh_token") and oauth.get("token_endpoint") and oauth.get("client_id")):
            raise CliError("Session expired and no refresh token saved. Run `ttt login` again.")
        try:
            tokens = http_json(
                str(oauth["token_endpoint"]),
                method="POST",
                form={
                    "grant_type": "refresh_token",
                    "client_id": str(oauth["client_id"]),
                    "refresh_token": str(oauth["refresh_token"]),
                },
            )
        except ApiError as exc:
            raise CliError(f"Token refresh failed ({exc}). Run `ttt login` again.") from exc
        oauth["access_token"] = tokens["access_token"]
        if tokens.get("refresh_token"):
            oauth["refresh_token"] = tokens["refresh_token"]
        oauth["expires_at"] = time.time() + float(tokens.get("expires_in", 0) or 0)
        persist(oauth)
    return str(oauth["access_token"])


def get_token() -> str:
    for var in ("TTT_API_TOKEN", "GV_API_TOKEN"):
        value = os.environ.get(var)
        if value:
            return value

    config = load_config()
    oauth = config.get("oauth")
    if oauth and oauth.get("access_token"):

        def persist_ttt(updated: dict) -> None:
            config["oauth"] = updated
            save_config(config)

        return _refresh_if_needed(oauth, persist_ttt)

    # Fall back to an existing first-party gv/tabtabtab CLI session. Rotated
    # refresh tokens are written back to the gv config so that CLI keeps working.
    try:
        gv_config = json.loads(GV_CONFIG_PATH.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        gv_config = {}
    gv_oauth = gv_config.get("oauth")
    if gv_oauth and gv_oauth.get("access_token"):

        def persist_gv(updated: dict) -> None:
            gv_config["oauth"] = updated
            GV_CONFIG_PATH.write_text(json.dumps(gv_config, indent=2) + "\n")
            GV_CONFIG_PATH.chmod(0o600)

        return _refresh_if_needed(gv_oauth, persist_gv)

    raise CliError("Not logged in. Run `ttt login` (or set TTT_API_TOKEN).")


def api(path: str, method: str = "GET", payload: dict | None = None, timeout: int = 60) -> dict:
    return http_json(
        f"{api_url()}{path}",
        method=method,
        payload=payload,
        headers={"Authorization": f"Bearer {get_token()}"},
        timeout=timeout,
    )


def cmd_whoami(args: argparse.Namespace) -> int:
    me = api("/v1/me")
    return emit(args, me, lambda: print(json.dumps(me, indent=2)))


# ---------------------------------------------------------------------------
# Output helpers


def emit(args: argparse.Namespace, data, human) -> int:
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2))
    else:
        human()
    return 0


def print_table(rows: list[dict], columns: list[tuple[str, str]]) -> None:
    if not rows:
        print("(none)")
        return
    widths = {key: len(title) for key, title in columns}
    rendered = []
    for row in rows:
        cells = {}
        for key, _title in columns:
            value = row.get(key)
            cells[key] = "" if value is None else str(value)
            widths[key] = max(widths[key], len(cells[key]))
        rendered.append(cells)
    header = "  ".join(title.ljust(widths[key]) for key, title in columns)
    print(header)
    print("  ".join("-" * widths[key] for key, _ in columns))
    for cells in rendered:
        print("  ".join(cells[key].ljust(widths[key]) for key, _ in columns))


# ---------------------------------------------------------------------------
# VMs (control plane "envs")


def list_envs() -> list[dict]:
    return api("/v1/envs").get("envs", [])


def resolve_env(name_or_id: str, reveal: bool = False) -> dict:
    envs = list_envs()
    matches = [env for env in envs if env.get("name") == name_or_id or env.get("id") == name_or_id]
    if not matches:
        names = ", ".join(str(env.get("name")) for env in envs) or "(no VMs yet — run `ttt vm create`)"
        raise CliError(f"No VM named '{name_or_id}'. Available: {names}")
    env = matches[0]
    if reveal:
        return api(f"/v1/envs/{env['id']}?reveal=true").get("env", {})
    return env


def git_config_default(key: str) -> str | None:
    try:
        value = subprocess.run(
            ["git", "config", "--get", key], capture_output=True, text=True, check=False
        ).stdout.strip()
        return value or None
    except OSError:
        return None


def cmd_vm_list(args: argparse.Namespace) -> int:
    envs = list_envs()
    return emit(
        args,
        envs,
        lambda: print_table(
            envs,
            [("name", "NAME"), ("status", "STATUS"), ("step", "STEP"), ("url", "URL"), ("lastSeenAt", "LAST SEEN")],
        ),
    )


def cmd_vm_create(args: argparse.Namespace) -> int:
    git_name = args.git_name or git_config_default("user.name")
    git_email = args.git_email or git_config_default("user.email")
    if not git_name or not git_email:
        raise CliError("Pass --git-name and --git-email (no local git config found to use as a default).")
    payload = {"name": args.name, "gitUserName": git_name, "gitUserEmail": git_email}
    if args.size:
        payload["size"] = args.size
    env = api("/v1/envs", method="POST", payload=payload).get("env", {})

    def human() -> None:
        print(f"Created VM '{env.get('name')}' (id {env.get('id')}). Provisioning has started.")
        print(f"URL (ready in a few minutes): {env.get('url')}")
        print(f"Watch progress with: ttt vm get {env.get('name')}")

    return emit(args, env, human)


def cmd_vm_get(args: argparse.Namespace) -> int:
    env = resolve_env(args.name)
    env = api(f"/v1/envs/{env['id']}").get("env", env)
    return emit(args, env, lambda: print(json.dumps(env, indent=2)))


def cmd_vm_delete(args: argparse.Namespace) -> int:
    env = resolve_env(args.name)
    if not args.yes:
        answer = input(f"Delete VM '{env.get('name')}' and everything on it? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            print("Aborted.")
            return 1
    result = api(f"/v1/envs/{env['id']}", method="DELETE")
    return emit(args, result, lambda: print(f"Deleted VM '{env.get('name')}'."))


def cmd_vm_restart(args: argparse.Namespace) -> int:
    env = resolve_env(args.name)
    endpoint = {"ide": "restart-ide", "instance": "restart-instance", "hard": "hard-restart"}[args.mode]
    result = api(f"/v1/envs/{env['id']}/{endpoint}", method="POST", timeout=300)
    return emit(args, result, lambda: print(f"Restart ({args.mode}) requested for '{env.get('name')}'."))


def cmd_vm_password(args: argparse.Namespace) -> int:
    env = resolve_env(args.name, reveal=True)
    data = {"username": env.get("opencodeUsername") or "opencode", "password": env.get("opencodePassword"), "url": env.get("url")}
    return emit(
        args,
        data,
        lambda: print(f"url: {data['url']}\nusername: {data['username']}\npassword: {data['password']}"),
    )


def ssh_key_path(env: dict) -> Path:
    ssh = api(f"/v1/envs/{env['id']}/ssh").get("ssh", {})
    key = str(ssh.get("privateKey", ""))
    if not key:
        raise CliError("Control plane did not return an SSH key for this VM.")
    if "-----BEGIN" not in key:
        key = base64.b64decode(key).decode("utf-8")
    KEYS_DIR.mkdir(parents=True, exist_ok=True)
    path = KEYS_DIR / f"{env.get('name', env['id'])}.pem"
    path.write_text(key if key.endswith("\n") else key + "\n")
    path.chmod(stat.S_IRUSR | stat.S_IWUSR)
    env["_ssh"] = ssh
    return path


def cmd_vm_ssh(args: argparse.Namespace) -> int:
    env = resolve_env(args.name)
    key = ssh_key_path(env)
    ssh = env["_ssh"]
    destination = f"{ssh.get('username', 'ubuntu')}@{ssh['publicIp']}"
    command = ["ssh", "-i", str(key), "-o", "StrictHostKeyChecking=accept-new", destination] + (args.command or [])
    if args.print_only:
        print(" ".join(command))
        return 0
    os.execvp("ssh", command)
    return 0  # unreachable


def cmd_vm_cp(args: argparse.Namespace) -> int:
    env = resolve_env(args.name)
    key = ssh_key_path(env)
    ssh = env["_ssh"]
    host = f"{ssh.get('username', 'ubuntu')}@{ssh['publicIp']}"
    remote = args.remote_path or "~/uploads/"
    command = (
        ["scp", "-i", str(key), "-o", "StrictHostKeyChecking=accept-new", "-r"]
        + [str(Path(p).expanduser()) for p in args.files]
        + [f"{host}:{remote}"]
    )
    print("+ " + " ".join(command), file=sys.stderr)
    return subprocess.run(command, check=False).returncode


# ---------------------------------------------------------------------------
# Repositories


def cmd_repo_list(args: argparse.Namespace) -> int:
    repos = api("/v1/repos").get("repos", [])
    return emit(
        args,
        repos,
        lambda: print_table(
            repos,
            [
                ("name", "NAME"),
                ("localPath", "VM PATH"),
                ("gitRemoteUrl", "REMOTE"),
                ("syncStatus", "SYNC"),
                ("targetEnvId", "ENV ID"),
            ],
        ),
    )


def cmd_repo_add(args: argparse.Namespace) -> int:
    env = resolve_env(args.vm)
    name = args.name or Path(urlparse(args.git_url).path).stem
    if not name:
        raise CliError("Could not derive a repo name from the URL; pass --name.")
    local_path = args.path or f"/home/{env.get('vmUsername', 'ubuntu')}/{name}"
    payload = {
        "localPath": local_path,
        "name": name,
        "targetEnvId": env["id"],
        "gitRemoteUrl": args.git_url,
    }
    if args.branch:
        payload["activeBranch"] = args.branch
        payload["defaultBranch"] = args.branch
    repo = api("/v1/repos", method="POST", payload=payload).get("repo", {})

    def human() -> None:
        print(f"Registered repo '{repo.get('name')}' → {repo.get('localPath')} on VM '{env.get('name')}'.")
        print(f"Sync status: {repo.get('syncStatus')} ({repo.get('syncStep')})")
        print("Check progress with: ttt repo list")

    return emit(args, repo, human)


def cmd_repo_sync(args: argparse.Namespace) -> int:
    repo = _resolve_repo(args.name)
    result = api(f"/v1/repos/{repo['id']}/sync", method="POST")
    return emit(args, result, lambda: print(f"Sync requested for '{repo.get('name')}'."))


def cmd_repo_delete(args: argparse.Namespace) -> int:
    repo = _resolve_repo(args.name)
    if not args.yes:
        answer = input(f"Unregister repo '{repo.get('name')}'? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            print("Aborted.")
            return 1
    result = api(f"/v1/repos/{repo['id']}", method="DELETE")
    return emit(args, result, lambda: print(f"Unregistered repo '{repo.get('name')}'."))


def _resolve_repo(name_or_id: str) -> dict:
    repos = api("/v1/repos").get("repos", [])
    matches = [repo for repo in repos if repo.get("name") == name_or_id or repo.get("id") == name_or_id]
    if not matches:
        names = ", ".join(str(repo.get("name")) for repo in repos) or "(none registered)"
        raise CliError(f"No repo named '{name_or_id}'. Available: {names}")
    return matches[0]


def cmd_repo_github(args: argparse.Namespace) -> int:
    env = resolve_env(args.vm)
    data = api(f"/v1/envs/{env['id']}/github-repositories")
    repos = data.get("repositories", [])
    return emit(
        args,
        data,
        lambda: print_table(
            repos,
            [("fullName", "REPO"), ("visibility", "VISIBILITY"), ("defaultBranch", "BRANCH"), ("cloneUrl", "CLONE URL")],
        ),
    )


# ---------------------------------------------------------------------------
# gv-code server on the VM (webhooks, kickoff, uploads)


def vm_server(env_name: str) -> tuple[dict, str, dict]:
    """Resolve a VM and return (env, base_url, basic-auth headers) for its gv-code server."""
    env = resolve_env(env_name, reveal=True)
    if env.get("status") != "ready":
        raise CliError(f"VM '{env.get('name')}' is not ready yet (status: {env.get('status')}).")
    password = env.get("opencodePassword")
    if not password:
        raise CliError("Control plane did not reveal the VM server password.")
    username = env.get("opencodeUsername") or "opencode"
    credentials = base64.b64encode(f"{username}:{password}".encode()).decode()
    return env, str(env["url"]).rstrip("/"), {"Authorization": f"Basic {credentials}"}


def webhook_info(base: str, headers: dict) -> dict:
    return http_json(f"{base}/ui/incoming-webhook", headers=headers)


def cmd_webhook_list(args: argparse.Namespace) -> int:
    _env, base, headers = vm_server(args.vm)
    info = webhook_info(base, headers)
    webhooks = [
        {
            **hook,
            "target": hook.get("target") if hook.get("targetType") == "project" else "meta",
            "revoked": "yes" if hook.get("timeRevoked") else "",
        }
        for hook in info.get("webhooks", [])
    ]

    def human() -> None:
        print_table(webhooks, [("name", "NAME"), ("id", "ID"), ("targetType", "TYPE"), ("revoked", "REVOKED"), ("url", "URL")])
        targets = info.get("targets", [])
        if targets:
            print("\nAvailable project targets:")
            print_table(targets, [("name", "NAME"), ("target", "PROJECT ID")])

    return emit(args, info, human)


def _resolve_target(info: dict, project: str | None) -> tuple[str, str]:
    if not project:
        return "meta", "meta"
    for target in info.get("targets", []):
        if project in (target.get("name"), target.get("target")):
            return "project", str(target["target"])
    names = ", ".join(str(t.get("name")) for t in info.get("targets", [])) or "(none — only GitHub-cloned projects can be targets)"
    raise CliError(f"No project '{project}' on this VM. Available: {names}")


def cmd_webhook_create(args: argparse.Namespace) -> int:
    _env, base, headers = vm_server(args.vm)
    info = webhook_info(base, headers)
    target_type, target = _resolve_target(info, args.project)
    result = http_json(
        f"{base}/ui/incoming-webhook/webhooks",
        method="POST",
        payload={"name": args.name, "targetType": target_type, "target": target},
        headers=headers,
    )

    def human() -> None:
        print(f"Created webhook '{args.name}' targeting {target_type}:{target}")
        print(f"URL: {result.get('url')}")
        print('POST JSON to it: {"message": "...", "attachments": [...]} — each call starts an agent session.')

    return emit(args, result, human)


def cmd_webhook_revoke(args: argparse.Namespace) -> int:
    _env, base, headers = vm_server(args.vm)
    info = webhook_info(base, headers)
    matches = [
        hook
        for hook in info.get("webhooks", [])
        if (hook.get("id") == args.webhook or hook.get("name") == args.webhook) and not hook.get("timeRevoked")
    ]
    if not matches:
        raise CliError(f"No active webhook '{args.webhook}' on this VM.")
    result = {}
    for hook in matches:
        result = http_json(f"{base}/ui/incoming-webhook/webhooks/{hook['id']}", method="DELETE", headers=headers)
    return emit(args, result, lambda: print(f"Revoked {len(matches)} webhook(s)."))


def _attachment_for(path: Path) -> dict:
    if not path.is_file():
        raise CliError(f"Not a file: {path}")
    content_type = ATTACHMENT_EXTENSION_TYPES.get(path.suffix.lower()) or mimetypes.guess_type(path.name)[0]
    if content_type not in WEBHOOK_ALLOWED_TYPES:
        allowed = ", ".join(sorted(WEBHOOK_ALLOWED_TYPES))
        raise CliError(
            f"'{path.name}' has an unsupported type for webhook upload ({content_type}). "
            f"Allowed: {allowed}. Tip: zip it, or use `ttt vm cp` to copy over SSH."
        )
    data = path.read_bytes()
    encoded = base64.b64encode(data).decode()
    return {
        "type": "image" if content_type.startswith("image/") else "file",
        "name": path.name,
        "contentType": content_type,
        "data": f"data:{content_type};base64,{encoded}",
        "_size": len(data),
    }


def _post_webhook(base: str, headers: dict, info: dict, args: argparse.Namespace, message: str | None) -> dict:
    target_type, target = _resolve_target(info, args.project)
    webhook_name = args.webhook_name
    active = [
        hook
        for hook in info.get("webhooks", [])
        if hook.get("name") == webhook_name
        and not hook.get("timeRevoked")
        and hook.get("targetType") == target_type
        and (target_type == "meta" or hook.get("target") == target)
    ]
    if active:
        url = str(active[0]["url"])
    else:
        created = http_json(
            f"{base}/ui/incoming-webhook/webhooks",
            method="POST",
            payload={"name": webhook_name, "targetType": target_type, "target": target},
            headers=headers,
        )
        url = str(created["url"])

    attachments = [_attachment_for(Path(p).expanduser()) for p in (getattr(args, "files", None) or [])]
    if len(attachments) > WEBHOOK_MAX_ATTACHMENTS:
        raise CliError(f"At most {WEBHOOK_MAX_ATTACHMENTS} files per call (got {len(attachments)}).")
    total = sum(a["_size"] for a in attachments)
    if total > WEBHOOK_MAX_TOTAL_BYTES:
        raise CliError(f"Attachments exceed the 50MB webhook limit ({total} bytes). Use `ttt vm cp` instead.")
    for attachment in attachments:
        attachment.pop("_size")

    payload: dict = {}
    if message:
        payload["message"] = message
    if attachments:
        payload["attachments"] = attachments
    return http_json(url, method="POST", payload=payload, timeout=300)


def cmd_kick(args: argparse.Namespace) -> int:
    _env, base, headers = vm_server(args.vm)
    info = webhook_info(base, headers)
    result = _post_webhook(base, headers, info, args, args.prompt)

    def human() -> None:
        print("Agent session started.")
        print(f"Session: {result.get('sessionUrl')}")

    return emit(args, result, human)


def cmd_upload(args: argparse.Namespace) -> int:
    _env, base, headers = vm_server(args.vm)
    info = webhook_info(base, headers)
    message = args.message or "Files uploaded via ttt CLI. Store them; no action needed unless instructed otherwise."
    result = _post_webhook(base, headers, info, args, message)

    def human() -> None:
        echo = result.get("echo", {})
        for attachment in echo.get("attachments", []):
            print(f"Uploaded {attachment.get('name')} → {attachment.get('path')}")
        print(f"Session: {result.get('sessionUrl')}")

    return emit(args, result, human)


# ---------------------------------------------------------------------------
# Argument parsing


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ttt",
        description="CLI for tabtabtab (gv-code) cloud dev environments.",
    )
    parser.add_argument("--version", action="version", version=f"ttt {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    def add_json(p: argparse.ArgumentParser) -> None:
        p.add_argument("--json", action="store_true", help="print raw JSON (for scripts/agents)")

    p = sub.add_parser("login", help="log in via browser (OAuth PKCE)")
    p.set_defaults(func=cmd_login)
    p = sub.add_parser("logout", help="remove saved credentials")
    p.set_defaults(func=cmd_logout)
    p = sub.add_parser("whoami", help="show the logged-in user")
    add_json(p)
    p.set_defaults(func=cmd_whoami)

    vm = sub.add_parser("vm", help="manage VMs (cloud dev environments)")
    vm_sub = vm.add_subparsers(dest="vm_command", required=True)

    p = vm_sub.add_parser("list", help="list your VMs")
    add_json(p)
    p.set_defaults(func=cmd_vm_list)

    p = vm_sub.add_parser("create", help="create a new VM")
    p.add_argument("name", help="3-30 chars: lowercase letters, numbers, hyphens")
    p.add_argument("--git-name", help="git author name (default: local git config)")
    p.add_argument("--git-email", help="git author email (default: local git config)")
    p.add_argument("--size", choices=["regular", "large"], help="VM size (large requires admin)")
    add_json(p)
    p.set_defaults(func=cmd_vm_create)

    p = vm_sub.add_parser("get", help="show one VM (full JSON)")
    p.add_argument("name")
    add_json(p)
    p.set_defaults(func=cmd_vm_get)

    p = vm_sub.add_parser("delete", help="delete a VM")
    p.add_argument("name")
    p.add_argument("--yes", action="store_true", help="skip confirmation")
    add_json(p)
    p.set_defaults(func=cmd_vm_delete)

    p = vm_sub.add_parser("restart", help="restart the IDE or the whole instance")
    p.add_argument("name")
    p.add_argument("--mode", choices=["ide", "instance", "hard"], default="ide")
    add_json(p)
    p.set_defaults(func=cmd_vm_restart)

    p = vm_sub.add_parser("password", help="reveal the VM's web login credentials")
    p.add_argument("name")
    add_json(p)
    p.set_defaults(func=cmd_vm_password)

    p = vm_sub.add_parser("ssh", help="SSH into a VM")
    p.add_argument("name")
    p.add_argument("--print-only", action="store_true", help="print the ssh command instead of running it")
    p.add_argument("command", nargs="*", help="optional remote command")
    p.set_defaults(func=cmd_vm_ssh)

    p = vm_sub.add_parser("cp", help="copy local files to a VM over SSH (any size/type)")
    p.add_argument("name")
    p.add_argument("files", nargs="+", help="local files or directories")
    p.add_argument("--remote-path", help="destination on the VM (default ~/uploads/)")
    p.set_defaults(func=cmd_vm_cp)

    repo = sub.add_parser("repo", help="manage repositories on your VMs")
    repo_sub = repo.add_subparsers(dest="repo_command", required=True)

    p = repo_sub.add_parser("list", help="list registered repos")
    add_json(p)
    p.set_defaults(func=cmd_repo_list)

    p = repo_sub.add_parser("add", help="register a git repo and clone it onto a VM")
    p.add_argument("git_url", help="git remote URL, e.g. https://github.com/you/app.git")
    p.add_argument("--vm", required=True, help="target VM name")
    p.add_argument("--name", help="repo display name (default: derived from URL)")
    p.add_argument("--path", help="absolute path on the VM (default /home/<vm-user>/<name>)")
    p.add_argument("--branch", help="branch to check out")
    add_json(p)
    p.set_defaults(func=cmd_repo_add)

    p = repo_sub.add_parser("sync", help="re-run sync for a repo")
    p.add_argument("name")
    add_json(p)
    p.set_defaults(func=cmd_repo_sync)

    p = repo_sub.add_parser("delete", help="unregister a repo")
    p.add_argument("name")
    p.add_argument("--yes", action="store_true", help="skip confirmation")
    add_json(p)
    p.set_defaults(func=cmd_repo_delete)

    p = repo_sub.add_parser("github", help="list GitHub repos the VM's GitHub connection can access")
    p.add_argument("--vm", required=True)
    add_json(p)
    p.set_defaults(func=cmd_repo_github)

    webhook = sub.add_parser("webhook", help="manage incoming webhooks on a VM")
    webhook_sub = webhook.add_subparsers(dest="webhook_command", required=True)

    p = webhook_sub.add_parser("list", help="list webhooks (URLs included) and available project targets")
    p.add_argument("--vm", required=True)
    add_json(p)
    p.set_defaults(func=cmd_webhook_list)

    p = webhook_sub.add_parser("create", help="create a webhook that starts an agent session when called")
    p.add_argument("name", help="webhook name")
    p.add_argument("--vm", required=True)
    p.add_argument("--project", help="target project name/id (default: the meta agent)")
    add_json(p)
    p.set_defaults(func=cmd_webhook_create)

    p = webhook_sub.add_parser("revoke", help="revoke a webhook by name or id")
    p.add_argument("webhook")
    p.add_argument("--vm", required=True)
    add_json(p)
    p.set_defaults(func=cmd_webhook_revoke)

    p = sub.add_parser("kick", help="kick off an agent on a VM with a prompt (and optional files)", aliases=["run", "prompt"])
    p.add_argument("vm", help="VM name")
    p.add_argument("prompt", help="what the agent should do")
    p.add_argument("--project", help="target project name/id (default: the meta agent)")
    p.add_argument("--file", dest="files", action="append", help="attach a file (repeatable, ≤5 files, ≤50MB total)")
    p.add_argument("--webhook-name", default="ttt-cli", help="webhook to use/create (default ttt-cli)")
    add_json(p)
    p.set_defaults(func=cmd_kick)

    p = sub.add_parser("upload", help="upload files to a VM's agent workspace")
    p.add_argument("vm", help="VM name")
    p.add_argument("files", nargs="+", help="files to upload (png/jpeg/webp/gif/txt/md/json/zip/csv)")
    p.add_argument("--project", help="target project name/id (default: the meta agent)")
    p.add_argument("--message", help="note for the agent about these files")
    p.add_argument("--webhook-name", default="ttt-cli", help="webhook to use/create (default ttt-cli)")
    add_json(p)
    p.set_defaults(func=cmd_upload)

    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except KeyboardInterrupt:
        print("\nAborted.", file=sys.stderr)
        return 130
    except CliError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
